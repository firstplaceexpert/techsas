# ============================================================
# TECHSAS — Universal Smart Asset Management Platform
# Environment Variables
# ============================================================
# Salin file ini sebagai .env.local dan isi dengan nilai Supabase project Anda

# Supabase Project URL (dari Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Anonymous/Public Key (dari Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opsional) Supabase Service Role Key — hanya untuk script backend/admin
# JANGAN expose ke browser! Simpan hanya di server-side.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
